            "get": {
                "operationId": "balances.show",
                "summary": "Get Balances for a specific account.\nMarket availability: Pan-Africa",
                "tags": [
                    "Balances"
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
