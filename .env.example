APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ABSA Statements API
ABSA_ENV=sandbox
ABSA_STATEMENTS_BASE_URL=https://api.absa.africa/cheque-statements/v1.0
ABSA_STATEMENTS_CLIENT_ID=
ABSA_STATEMENTS_PASSPHRASE=
ABSA_STATEMENTS_CERT_PATH=storage/app/private/certs/private/absa/absa_statements_client_cert.p12
ABSA_STATEMENTS_RETRY_ATTEMPTS=3
ABSA_STATEMENTS_RETRY_DELAY_MS=250

# ABSA Statements API — OAuth2 Resource Owner Password (grant_type=password, ADR-001)
ABSA_STATEMENTS_OAUTH_TOKEN_URL=https://mtls.auth.absaaccess.africa/connect/token
ABSA_STATEMENTS_SCOPE=bifrost-gateway
ABSA_STATEMENTS_USERNAME=
ABSA_STATEMENTS_PASSWORD=
ABSA_STATEMENTS_TOKEN_CACHE_KEY=absa.statements.oauth_token
ABSA_STATEMENTS_TOKEN_TTL_BUFFER=60
# Audit logging
ABSA_STATEMENTS_AUDIT_ENABLED=true
ABSA_STATEMENTS_AUDIT_QUEUE=default
